# Example agent configuration.
#
# You normally do NOT create this by hand: `source activate.sh` generates
# diabetes_agent/.env from your current shell settings. This file is committed
# so you can see what the generated file looks like.
#
# `adk web` reads this file when running locally, and
# `adk deploy agent_engine` reads it and turns these into the deployed agent's
# environment variables.
#
# NOTE: GOOGLE_CLOUD_LOCATION here is where the MODEL is served. The current
# Gemini models are served from "global". It is NOT where the agent is
# deployed - Agent Runtime needs a real region, which 4_deploy.sh passes as
# --region (us-central1 by default).
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
PROJECT_ID=your-project-id
BQ_DATASET=demo_diabetes
AGENT_MODEL=gemini-flash-latest
